{
  // Deploy na Cloudflare (Workers com Static Assets): serve o build estático
  // do Vite (dist/) como SPA — sem código de Worker. O fallback de rotas para
  // index.html faz /scorecomps, /cubestaff etc. funcionarem ao recarregar.
  "name": "scorecomps",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
