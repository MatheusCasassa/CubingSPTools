# Todas as variáveis são OPCIONAIS — o app já vem com os valores de produção.
# Copie para .env.local se quiser sobrepor algo no seu computador.

# Client ID (Application UID) do app OAuth da WCA (cliente público, sem secret).
# VITE_WCA_CLIENT_ID=excsX95XmC-vQcKfCd7Qno_4yw7KjFgDz1HLs1jtIws

# Origem da WCA (produção ou staging).
# VITE_WCA_ORIGIN=https://www.worldcubeassociation.org

# Site da CubingSP (link "Voltar para a CubingSP" no cabeçalho).
# VITE_CUBINGSP_URL=https://cubingsp-site.matcasviana.workers.dev
